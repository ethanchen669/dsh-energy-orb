{
  "name": "dsh-energy-orb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/ethanchen669/dsh-energy-orb.git" },
  "homepage": "https://github.com/ethanchen669/dsh-energy-orb#readme",
  "bugs": { "url": "https://github.com/ethanchen669/dsh-energy-orb/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**",
    "client/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
