{
  "name": "@dsh-fly/dsh-energy-orb",
  "version": "0.1.0",
  "description": "Web3D energy orb for the DeepSeek Harness Web GUI: a status-only decoration that shrinks and goes silent while idle and heart-beats while a turn runs.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web3d",
    "three",
    "status",
    "decoration"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-energy-orb.git"
  },
  "homepage": "https://github.com/ethanchen669/dsh-energy-orb#readme",
  "bugs": {
    "url": "https://github.com/ethanchen669/dsh-energy-orb/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**",
    "client/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node --test",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "vendor:check": "node scripts/vendor-sphere.mjs --check",
    "shoot:readme": "node scripts/shoot-readme.mjs",
    "check:identity": "node scripts/check-commit-identity.mjs --all"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "playwright-core": "1.63.0"
  }
}
